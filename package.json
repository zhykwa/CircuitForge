{
  "name": "circuitforge",
  "version": "1.0.0",
  "description": "Desktop Microcontroller Simulator — Arduino CLI + MQTT + Blynk + HTTP",
  "main": "main.js",
  "homepage": "https://github.com/circuitforge",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": ["arduino", "esp32", "simulator", "iot", "mqtt", "blynk", "electron"],
  "author": "CircuitForge",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "electron-store": "^8.2.0",
    "mqtt": "^5.5.0",
    "node-pty": "^1.0.0",
    "serialport": "^12.0.0",
    "ws": "^8.18.0",
    "extract-zip": "^2.0.1",
    "node-fetch": "^3.3.2",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.circuitforge.app",
    "productName": "CircuitForge",
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" }
  }
}
